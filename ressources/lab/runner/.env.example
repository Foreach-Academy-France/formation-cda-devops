# Copier en « .env » (cp .env.example .env) puis remplir. Le .env n'est JAMAIS
# commité : il contient un jeton.

# Adresse de VOTRE dépôt (pas celui du formateur)
REPO_URL=https://github.com/VOTRE-PSEUDO/taskflow

# Jeton d'enregistrement : dépôt > Settings > Actions > Runners > New self-hosted runner
# Valable environ 1 heure : à copier juste avant de démarrer.
RUNNER_TOKEN=

RUNNER_NAME=lab-runner
LABELS=self-hosted,lab

# Dossiers « serveur » : CHEMINS ABSOLUS, sans ~ ni $HOME (echo $HOME pour le début).
#   Linux / WSL2 : /home/<vous>/...   (WSL2 : dans WSL, pas sous /mnt/c)
#   macOS        : /Users/<vous>/...  (dossier partagé avec Docker Desktop)
PROD_DIR=/home/VOUS/taskflow-prod
STAGING_DIR=/home/VOUS/taskflow-staging
